# Copy to .env and fill in locally. Never commit .env.

# Meta Model API (https://dev.meta.ai/docs). Bearer key.
MODEL_API_KEY=

# Live model calls are OFF unless this is true. Tests never enable it.
STS_ALLOW_LIVE_MODEL_CALLS=false

STS_META_API_BASE=https://api.meta.ai/v1
STS_VISION_MODEL=muse-spark-1.3
STS_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
STS_SEGMENT_MODEL=sam-3.1
# One billed SAM request per phrase, separated by ;
STS_SAM_PROMPTS=product package;bottle

# Storage
STS_RUNS_DIR=runs
STS_DB_PATH=var/stall_to_store.db

# Upload limits
STS_MAX_UPLOAD_MB=200
STS_MIN_DURATION_S=5
STS_MAX_DURATION_S=90

# Required on any public server: only people with this code can upload
STS_UPLOAD_CODE=

# Show the "load development fixture" button (fixtures are labelled everywhere)
STS_DEV_FIXTURES=false

# Order proposals
STS_PROPOSAL_TTL_MINUTES=15
STS_CLICK_TO_CHAT_TTL_MINUTES=1440
